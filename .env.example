# SSH / VNC password for the dev user. Set before starting.
PASSWORD=

# Stable device name on your Tailscale network.
TS_HOSTNAME=cc-dev

# Host paths (absolute; Compose does not expand "~").
# The Mac workspace that the development machines work on.
WORKSPACE_DIR=/Users/you/workspace
# Runtime data outside the workspace: the Linux mirror (linux-workspace/),
# the shared git store (git/), job state and logs.
RUNTIME_DIR=/Users/you/.cc-runtime
# Mounted at /home/dev/Downloads in every machine.
DOWNLOADS_DIR=/Users/you/Downloads

# Optional: development image, and the Docker volume and subpaths for each
# machine's ~/.cache (created on first start).
# DEV_IMAGE=ghcr.io/zeke-chin/cc-runtime:latest
# CACHE_VOLUME=cc-runtime-cache
# DEV_PA_CACHE=dev-PA
# DEV_CA_CACHE=dev-CA
