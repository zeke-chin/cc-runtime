# dev 用户的 SSH / VNC 密码，启动前必须设置。
PASSWORD=

# 在 Tailscale 网络中使用的固定设备名。
TS_HOSTNAME=cc-dev

# 宿主机路径（必须是绝对路径；Compose 不会展开 "~"）。
# 开发机使用的 Mac 工作区。
WORKSPACE_DIR=/Users/you/workspace
# 工作区以外的运行时数据：Linux 副本（linux-workspace/）、
# 共享 git 目录（git/）、任务状态和日志。
RUNTIME_DIR=/Users/you/.cc-runtime
# 在每台开发机中挂载到 /home/dev/Downloads。
DOWNLOADS_DIR=/Users/you/Downloads

# 可选：开发镜像，以及各开发机 ~/.cache 所用的 Docker 卷和子路径
# （首次启动时创建）。
# DEV_IMAGE=ghcr.io/zeke-chin/cc-runtime:latest
# CACHE_VOLUME=cc-runtime-cache
# DEV_PA_CACHE=dev-PA
# DEV_CA_CACHE=dev-CA
